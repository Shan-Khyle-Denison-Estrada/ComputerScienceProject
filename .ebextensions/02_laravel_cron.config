files:
  "/etc/cron.d/laravel_scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      * * * * * root su -s /bin/bash -c ". /opt/elasticbeanstalk/deployment/env && /usr/bin/php /var/app/current/artisan schedule:run >> /var/app/current/storage/logs/cron.log 2>&1" webapp

commands:
  01_remove_old_cron:
    command: "rm -f /etc/cron.d/laravel_scheduler.bak"
  02_restart_cron:
    command: "systemctl restart crond"
    ignoreErrors: true