files:
  "/etc/cron.d/laravel_scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      * * * * * webapp . /opt/elasticbeanstalk/deployment/env && cd /var/app/current && php artisan schedule:run >> /var/app/current/storage/logs/cron.log 2>&1

commands:
  remove_old_cron:
    command: "rm -f /etc/cron.d/laravel_scheduler.bak"